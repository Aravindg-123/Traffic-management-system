# ANPR Trajectory Dashboard — Environment Overrides
#
# Copy this file to .env and set values as needed.
# These variables can also be set directly in a PowerShell session:
#
#   $env:ANPR_DB_PATH = "anpr_demo_fixed.db"
#   $env:MARKOV_MODEL_DIR = "handoff_package_v2"
#   $env:MAX_TRAJECTORY_GAP_SECONDS = "900"
#   $env:TOP_K = "3"
#
# All paths are relative to the project root unless you supply an absolute path.
# NOTE: markov_integration/config.py reads these via os.getenv() ONLY.
#       python-dotenv is NOT used; set vars in your shell before running.

ANPR_DB_PATH=anpr_demo_fixed.db
MARKOV_MODEL_DIR=handoff_package_v2
MAX_TRAJECTORY_GAP_SECONDS=900
TOP_K=3
